config_version=5

[application]
config/name="Underwater"
config/version="0.1.0"
config/description="A saturation diver's watch on the Kestrel production platform."
run/main_scene="res://game/dive.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.022,0.067,0.078,1)
config/quit_on_go_back=false

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035,0.098,0.11,1)

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
